# Copiez ce modèle vers ~/.config/zaama/zaama-api.env sur la VM.
# Ne commitez jamais le vrai fichier de secrets.
APP_NAME=ZAAMA
APP_ENV=production
NODE_ENV=production
HOST=127.0.0.1
PORT=4110
TRUST_PROXY=true

DATABASE_URL=postgresql://zaama_app:CHANGE_ME@127.0.0.1:5432/zaama_prod?schema=public

JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CONTACT_HASH_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS
ADMIN_JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS

# Pilote privé uniquement. Remplacer par un fournisseur SMS avant ouverture publique.
OTP_MODE=pilot
PILOT_ALLOWED_PHONES=+22670000000
PILOT_OTP=CHANGE_ME_6_DIGITS
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DAILY_LIMIT_PER_PHONE=8

# Pour 200 testeurs, créez une application sur developer.orange.com, souscrivez
# à SMS Burkina Faso et remplacez OTP_MODE=pilot par OTP_MODE=orange_sms.
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_ADDRESS=tel:+2260000
ORANGE_SMS_SENDER_NAME=

# Encaissement réel du ZAAMA Wallet. La clé et le secret restent uniquement
# dans ce fichier protégé de la VM (chmod 600), jamais dans Git ni Flutter.
YENGAPAY_BASE_URL=https://api.yengapay.com/api/v1
YENGAPAY_API_KEY=
YENGAPAY_ORGANIZATION_ID=
YENGAPAY_PROJECT_ID=
YENGAPAY_WEBHOOK_SECRET=

# Notifications Android/iOS. Copiez le compte de service hors du dépôt, puis
# donnez à PM2 son chemin absolu. Permissions recommandées pour le JSON : 600.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/home/debian/.config/zaama/firebase-service-account.json

CORS_ORIGINS=https://zaamabackend.yingr-ai.com
REDIS_URL=
# Sans Docker : stockage privé sur disque, exposé uniquement par liens signés.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=/home/debian/.local/share/zaama/uploads
PUBLIC_API_URL=https://zaamabackend.yingr-ai.com/api/v1
MEDIA_SIGNING_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS
# Pour basculer vers un stockage objet plus tard : STORAGE_DRIVER=s3.
S3_ENDPOINT=
S3_BUCKET=zaama-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=104857600
# Le serveur relaie les médias chiffrés. Après lecture par tous les membres,
# ils sont supprimés après 30 jours, et au plus tard après 90 jours.
MEDIA_RELAY_CLEANUP_ENABLED=true
MEDIA_RELAY_READ_RETENTION_DAYS=30
MEDIA_RELAY_MAX_RETENTION_DAYS=90
MEDIA_RELAY_CLEANUP_INTERVAL_HOURS=6

STUN_URL=
# Plusieurs URL peuvent être séparées par des virgules (UDP puis TCP/TLS).
TURN_URL=
# Secret REST coturn partagé. Il reste uniquement sur le backend et le serveur TURN.
TURN_SHARED_SECRET=
