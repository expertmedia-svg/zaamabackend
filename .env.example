# App
APP_NAME=Project Saaga
APP_ENV=development
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Database
POSTGRES_DB=saaga
POSTGRES_USER=saaga
POSTGRES_PASSWORD=saaga_dev_password
DATABASE_URL=postgresql://saaga:saaga_dev_password@localhost:5432/saaga?schema=public

# Redis (facultatif en développement local, requis pour le multi-instance)
REDIS_URL=

# JWT
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production_refresh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CONTACT_HASH_SECRET=change_me_in_production_contact_hash
CORS_ORIGINS=http://localhost:5173

# Stockage média. `local` ne requiert ni Docker ni service supplémentaire.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./var/uploads
PUBLIC_API_URL=http://localhost:4000/api/v1
MEDIA_SIGNING_SECRET=change_me_minimum_32_characters_media
# Stockage S3-compatible optionnel (`STORAGE_DRIVER=s3`)
S3_ENDPOINT=
S3_BUCKET=saaga-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=104857600

# OTP dev
DEV_OTP=123456
OTP_TTL_SECONDS=300

# Firebase / FCM
FCM_PROJECT_ID=project-saaga-dev
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# WebRTC / TURN. Utiliser le même TURN_SHARED_SECRET dans coturn.
STUN_URL=
TURN_URL=
TURN_SHARED_SECRET=

# Admin
ADMIN_EMAIL=admin@saaga.local
ADMIN_PASSWORD=admin123
ADMIN_JWT_SECRET=change_me_in_production_admin

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENDPOINT=http://localhost:9090

# App config
MINIMUM_SUPPORTED_VERSION=1.0.0
LATEST_VERSION=1.0.0
FEATURE_STORIES=true
FEATURE_VIDEO_CALLS=true
FEATURE_EXPERIMENTAL_CAMERA=false
