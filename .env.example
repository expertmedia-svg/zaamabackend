# Configuration locale uniquement. Ne jamais utiliser ces valeurs en production.
APP_NAME=ZAAMA
APP_ENV=development
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

DATABASE_URL=postgresql://zaama:zaama_dev_password@127.0.0.1:5432/zaama?schema=public

JWT_SECRET=development_jwt_secret_change_before_production
JWT_REFRESH_SECRET=development_refresh_secret_change_before_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CONTACT_HASH_SECRET=development_contact_hash_change_before_production
ADMIN_JWT_SECRET=development_admin_secret_change_before_production

DEV_OTP=123456
OTP_TTL_SECONDS=300
CORS_ORIGINS=http://localhost:5173

REDIS_URL=
S3_ENDPOINT=
S3_BUCKET=zaama-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=104857600

TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
