# Copiez ce modèle vers ~/.config/zaama/zaama-api.env sur la VM.
# Ne commitez jamais le vrai fichier de secrets.
APP_NAME=ZAAMA
APP_ENV=production
NODE_ENV=production
HOST=127.0.0.1
PORT=4110
TRUST_PROXY=true

DATABASE_URL=postgresql://zaama_app:CHANGE_ME@127.0.0.1:5432/zaama_prod?schema=public

JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CONTACT_HASH_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS
ADMIN_JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS

# Pilote privé uniquement. Remplacer par un fournisseur SMS avant ouverture publique.
OTP_MODE=pilot
PILOT_ALLOWED_PHONES=+22670000000
PILOT_OTP=CHANGE_ME_6_DIGITS
OTP_TTL_SECONDS=300

# Pour 200 testeurs, créez une application sur developer.orange.com, souscrivez
# à SMS Burkina Faso et remplacez OTP_MODE=pilot par OTP_MODE=orange_sms.
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_ADDRESS=tel:+2260000
ORANGE_SMS_SENDER_NAME=

CORS_ORIGINS=https://zaamabackend.yingr-ai.com
REDIS_URL=
S3_ENDPOINT=
S3_BUCKET=zaama-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=104857600

TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
